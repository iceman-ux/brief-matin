.env
__pycache__/
*.pyc
.venv/
# data/scripts/ est versionné : sans lui, un brief raté sur GitHub
# Actions n'est pas débuggable après coup. ~1 Mo par an.

# Le silence produit par --dry-run, jamais publié.
data/dry-run.mp3

data/dry-run.txt

# Les essais d'écoute : des mp3 lourds qui n'ont rien à faire dans l'historique.
tests/
# Le test de voix à l'aveugle : mp3 et clé de correspondance, jamais publiés.
data/voice-test/

# Dossier de travail de l'outillage, pas du projet.
Claude outputs/

# Fichier local de Claude Code (tâches programmées de la session).
.claude/scheduled_tasks.lock
# Les mp3 vivent dans la Release « episodes » (audio.storage). Les fichiers
# déjà suivis le restent jusqu'à leur expiration ; un épisode de repli, servi
# depuis docs/, est ajouté de force par le workflow.
docs/episodes/*.mp3
